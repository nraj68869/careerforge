DB_URL=jdbc:postgresql://localhost:5432/your_database_name
DB_USERNAME=postgres
DB_PASSWORD=your-database-password

# generate a 44-character secret (command in the README)
JWT_SECRET=replace-with-a-generated-base64-secret
JWT_ISSUER=careerforge
JWT_EXPIRATION_MINUTES=30

CORS_ALLOWED_ORIGINS=http://localhost:5173

# the first admin account, created on first start
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-at-least-10-characters

UPLOAD_DIR=./uploads.